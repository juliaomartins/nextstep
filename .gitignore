# Personal learning context (kept out of commits by default)
/devpost/learner-profile.md

# Local credentials
.env
.env.*
!.env.example

# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# generated by scripts/copy-pdf-worker.mjs
/public/pdf.worker.min.mjs

# Installed coding-agent skills (third-party content; skills-lock.json records what was installed)
/.agents/
/.claude/
/agent/

# Built Chrome extension (npm run build:extension)
/extension/dist/

# Packed extension (Chrome "Pack extension"); its .pem private key is already ignored by *.pem
/extension/*.crx

# Chrome Web Store upload packages (npm run pack:extension)
/extension/*.zip
