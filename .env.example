OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: secret for sealing checklists handed to /results. Derived from OPENAI_API_KEY when empty.
HANDOFF_SECRET=
# Optional: the Chrome Web Store listing URL, once published. Shown as "Add to Chrome".
NEXT_PUBLIC_EXTENSION_URL=
# Optional (build time): the public https address the Chrome extension should use. Defaults to Vercel's production domain.
NEXTSTEP_URL=
